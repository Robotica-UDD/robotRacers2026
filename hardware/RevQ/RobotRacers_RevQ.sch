<description>TURBINA / CONTROL PRELIMINAR - FAN_V_EXT SIN ALIMENTAR</description>
<plain>
<wire x1="0" y1="0" x2="406.4" y2="0" width="0.254" layer="97"/>
<wire x1="406.4" y1="0" x2="406.4" y2="254" width="0.254" layer="97"/>
